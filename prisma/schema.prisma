// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"

}


model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  gallery      Gallery[]
  sessions      Session[]
  pages        Page[]
   sites         Site[]
  @@index([id])
  @@index([name])
  @@index([email])
  @@map("user")
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  idToken      String?
  expiresAt    DateTime?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([id])
  @@index([userId,accountId])
  @@map("account")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    @@index([id,userId])
  @@map("session")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([id,identifier])
  @@map("verification")
}

enum Gender {
  MALE
  FEMALE
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
}

model Applicant {
  id              String            @id @default(uuid())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Personal Information
  firstName       String
  lastName        String
  email           String            @unique
  phone           String
  dateOfBirth     DateTime
  gender          Gender

  // Program Details
  programApplied  String
  intendedTerm    String

  status          ApplicationStatus @default(SUBMITTED)
  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([firstName, lastName])
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Page {
  id               String     @id @default(cuid())
  title            String
  slug             String     @unique
  shortDescription String?    @db.Text
  content          Json       // Tiptap JSON document tree
  status           PageStatus @default(DRAFT)
  image            String[]    @db.Text
  authorId         String
  author           User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([slug])
   @@index([createdAt])
   @@index([title])
  @@index([authorId])
  @@index([status])
  @@map("page")
}

model Gallery {
  id               String     @id @default(cuid())
  title            String
  image            String[]    @db.Text
  video            String?    @db.Text
  description      String?    @db.Text
  authorId         String
  author           User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([id])
   @@index([createdAt])
   @@index([title])
  @@index([authorId])
  @@map("gallery")
}
